# Copy to .env. Values must match the project auto-provisioned by
# langfuse/.env (LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY).
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_WITH_SAME_UUID_AS_LANGFUSE_INIT_PROJECT_PUBLIC_KEY
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_WITH_SAME_UUID_AS_LANGFUSE_INIT_PROJECT_SECRET_KEY
LANGFUSE_HOST=http://localhost:3000
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=your-generated-password
# Defaults to "neo4j" if unset -- but on Aura Free instances the database is
# often named after the instance ID too, same as NEO4J_USER above.
NEO4J_DATABASE=xxxxxxxx
