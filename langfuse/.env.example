# Copy to .env and fill in real values (or run the generator described in
# README.md's step 5 section). .env itself is gitignored — only this
# template is version controlled.

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
SALT=
# 64 hex chars (32 bytes) -- generate with: openssl rand -hex 32
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# The compose file's DATABASE_URL/S3 key defaults don't auto-pick-up the
# POSTGRES_PASSWORD/MINIO_ROOT_PASSWORD above -- they must be repeated here.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/postgres
MINIO_ROOT_USER=minio
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD

# Auto-provisioned on first boot so the agent has stable API keys without a
# manual UI setup step.
LANGFUSE_INIT_ORG_ID=agentic-platform
LANGFUSE_INIT_ORG_NAME=Agentic Platform POC
LANGFUSE_INIT_PROJECT_ID=agentic-platform-poc
LANGFUSE_INIT_PROJECT_NAME=Agentic Platform POC
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-REPLACE_WITH_UUID
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-REPLACE_WITH_UUID
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=
